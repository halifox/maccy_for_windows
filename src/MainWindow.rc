#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

// The history popup deliberately contains only the search field and history
// list; it has no caption or extra status controls.
IDD_HISTORY DIALOGEX 0, 0, 366, 277
STYLE WS_POPUP | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    // No ES_MULTILINE: the search field is intentionally a single-line edit control.
    EDITTEXT IDC_HISTORY_SEARCH, 5, 5, 357, 18, ES_AUTOHSCROLL | WS_TABSTOP | WS_VISIBLE, WS_EX_CLIENTEDGE
    LISTBOX IDC_HISTORY_LIST, 5, 24, 357, 248, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | LBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP | WS_VISIBLE | WS_BORDER, WS_EX_CLIENTEDGE
END

// The preview is a separate owned popup. The image and text controls share
// the same content area; PreviewWindow selects the one appropriate for the
// current item.
IDD_PREVIEW DIALOGEX 0, 0, 380, 330
STYLE WS_POPUP | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
CAPTION "剪贴板预览"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_PREVIEW_IMAGE, "STATIC", SS_OWNERDRAW | WS_BORDER | WS_VISIBLE, 8, 8, 364, 258
    EDITTEXT IDC_PREVIEW_TEXT, 8, 8, 364, 258, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_PREVIEW_STATUS, 8, 272, 364, 48, SS_LEFT | SS_NOPREFIX | WS_VISIBLE
END
