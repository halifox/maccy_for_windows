#pragma code_page(65001)

#include <winresrc.h>
#include "resource.h"

// The preview is a separate owned popup with a fixed resource layout. The
// image and text controls share the same content area; PreviewWindow selects
// the one appropriate for the current item.
IDD_PREVIEW DIALOGEX 0, 0, 206, 160
STYLE WS_POPUP | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "置顶", IDC_PREVIEW_PIN, 146, 4, 25, 14, BS_FLAT
    PUSHBUTTON "删除", IDC_PREVIEW_DELETE, 175, 4, 25, 14, BS_FLAT
    CONTROL "", IDC_PREVIEW_IMAGE, "STATIC", SS_OWNERDRAW | WS_BORDER | WS_VISIBLE, 6, 22, 194, 98
    EDITTEXT IDC_PREVIEW_TEXT, 6, 22, 194, 98, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "示例值", IDC_PREVIEW_STATUS, 6, 124, 194, 32, SS_LEFT | SS_NOPREFIX | WS_VISIBLE
END
