#pragma code_page(65001)

#include <winresrc.h>
#include "resource.h"

// The history popup uses a resource template for all native controls. Its
// runtime layout remains centralized in MainWindow because visibility and
// list heights depend on settings and the current history.
IDD_HISTORY DIALOGEX 0, 0, 300, 180
STYLE WS_POPUP | WS_THICKFRAME | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_HISTORY_SEARCH, 0, 0, 250, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_VISIBLE, WS_EX_CLIENTEDGE
    LISTBOX IDC_HISTORY_LIST, 0, 16, 300, 100, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_HASSTRINGS | LBS_OWNERDRAWVARIABLE | WS_VSCROLL | WS_TABSTOP | WS_VISIBLE, WS_EX_CLIENTEDGE
    LISTBOX IDC_HISTORY_PINS, 0, 16, 300, 30, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_HASSTRINGS | LBS_OWNERDRAWVARIABLE | WS_VSCROLL | WS_TABSTOP | WS_VISIBLE, WS_EX_CLIENTEDGE
    CONTROL "预览", IDC_HISTORY_PREVIEW, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_VISIBLE, 0, 0, 40, 14
    CONTROL "清空历史", IDC_HISTORY_CLEAR, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_VISIBLE, 0, 116, 300, 14
    CONTROL "设置…", IDC_HISTORY_SETTINGS, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_VISIBLE, 0, 130, 300, 14
    CONTROL "关于…", IDC_HISTORY_ABOUT, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_VISIBLE, 0, 144, 300, 14
    CONTROL "退出", IDC_HISTORY_EXIT, "Button", BS_OWNERDRAW | WS_TABSTOP | WS_VISIBLE, 0, 158, 300, 14
END

// The preview is a separate owned popup with a fixed resource layout. The
// image and text controls share the same content area; PreviewWindow selects
// the one appropriate for the current item.
IDD_PREVIEW DIALOGEX 0, 0, 206, 160
STYLE WS_POPUP | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "置顶", IDC_PREVIEW_PIN, 146, 4, 25, 14, BS_FLAT
    PUSHBUTTON "删除", IDC_PREVIEW_DELETE, 175, 4, 25, 14, BS_FLAT
    CONTROL "", IDC_PREVIEW_IMAGE, "STATIC", SS_OWNERDRAW | WS_BORDER | WS_VISIBLE, 6, 22, 194, 98
    EDITTEXT IDC_PREVIEW_TEXT, 6, 22, 194, 98, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "示例值", IDC_PREVIEW_STATUS, 6, 124, 194, 32, SS_LEFT | SS_NOPREFIX | WS_VISIBLE
END
