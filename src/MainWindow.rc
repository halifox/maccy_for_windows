#pragma code_page(65001)

#include <winresrc.h>
#include "resource.h"

// The history popup deliberately has no caption. Its title and footer are
// content-area options controlled by AppSettings, and its border is used for
// native edge resizing.
// Keep the resource close to maccy's default ~450 px content width. Runtime
// settings still control the actual persisted width and DPI-aware placement.
IDD_HISTORY DIALOGEX 0, 0, 450, 277
STYLE WS_POPUP | WS_THICKFRAME | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "maccy", IDC_HISTORY_TITLE, 0, 0, 62, 20, SS_LEFT | SS_CENTERIMAGE | SS_NOPREFIX
    EDITTEXT IDC_HISTORY_SEARCH, 0, 0, 380, 20, ES_AUTOHSCROLL | WS_TABSTOP | WS_VISIBLE
    LISTBOX IDC_HISTORY_LIST, 0, 26, 450, 160, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP | WS_VISIBLE
    LISTBOX IDC_HISTORY_PINS, 0, 26, 450, 48, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    CONTROL "清空历史", IDC_HISTORY_CLEAR, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 190, 450, 18
    CONTROL "设置…", IDC_HISTORY_SETTINGS, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 210, 450, 18
    CONTROL "关于…", IDC_HISTORY_ABOUT, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 230, 450, 18
    CONTROL "退出", IDC_HISTORY_EXIT, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 250, 450, 18
    CONTROL "×", IDC_HISTORY_SEARCH_CLEAR, "Button", BS_OWNERDRAW | WS_TABSTOP, 390, 0, 20, 18
    CONTROL "◧", IDC_HISTORY_PREVIEW, "Button", BS_OWNERDRAW | WS_TABSTOP, 424, 0, 24, 18

END

// The preview is a separate owned popup. The image and text controls share
// the same content area; PreviewWindow selects the one appropriate for the
// current item.
IDD_PREVIEW DIALOGEX 0, 0, 380, 330
STYLE WS_POPUP | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "置顶", IDC_PREVIEW_PIN, 200, 4, 55, 18, BS_FLAT
    PUSHBUTTON "删除", IDC_PREVIEW_DELETE, 260, 4, 55, 18, BS_FLAT
    PUSHBUTTON "关闭预览", IDC_PREVIEW_CLOSE, 320, 4, 55, 18, BS_FLAT
    CONTROL "", IDC_PREVIEW_IMAGE, "STATIC", SS_OWNERDRAW | WS_BORDER | WS_VISIBLE, 8, 8, 364, 258
    EDITTEXT IDC_PREVIEW_TEXT, 8, 8, 364, 258, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_PREVIEW_STATUS, 8, 272, 364, 48, SS_LEFT | SS_NOPREFIX | WS_VISIBLE
END
