#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

// The history popup has a fixed resource layout. Optional controls may be
// hidden by C++, but the list itself never moves or changes size.
IDD_HISTORY DIALOGEX 0, 0, 366, 277
STYLE WS_POPUP | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_CONTROLPARENT
CAPTION "Clipboard"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "剪贴板历史", IDC_HISTORY_TITLE, 6, 4, 354, 13, SS_LEFT | SS_NOPREFIX | WS_VISIBLE
    EDITTEXT IDC_HISTORY_SEARCH, 5, 18, 357, 16, ES_AUTOHSCROLL | WS_TABSTOP | WS_VISIBLE, WS_EX_CLIENTEDGE
    LISTBOX IDC_HISTORY_LIST, 5, 36, 357, 228, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_HASSTRINGS | LBS_OWNERDRAWFIXED | LBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP | WS_VISIBLE | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "暂无剪贴板记录", IDC_HISTORY_EMPTY, 5, 36, 357, 228, SS_CENTER | SS_CENTERIMAGE | SS_NOPREFIX | WS_VISIBLE
    LTEXT "", IDC_HISTORY_FOOTER, 5, 264, 357, 13, SS_RIGHT | SS_NOPREFIX | WS_VISIBLE
END

// The preview is a separate owned popup. The image and text controls share
// the same content area; PreviewWindow selects the one appropriate for the
// current item.
IDD_PREVIEW DIALOGEX 0, 0, 340, 292
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
CAPTION "剪贴板预览"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_PREVIEW_IMAGE, "STATIC", SS_OWNERDRAW | WS_BORDER | WS_VISIBLE, 8, 8, 324, 258
    EDITTEXT IDC_PREVIEW_TEXT, 8, 8, 324, 258, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_PREVIEW_STATUS, 8, 270, 324, 14, SS_LEFT | SS_NOPREFIX | WS_VISIBLE
END
