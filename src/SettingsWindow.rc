IDD_PAGE_ADVANCED DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "暂停", IDC_X_IGNORE_EVENTS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 5, 24, 10
    LTEXT "暂停记录新的剪贴板项目。\r\n如果您想在复制敏感数据时通过程序调用来禁用本程序。", IDC_STATIC, 8, 17, 200, 28, SS_LEFT | SS_NOPREFIX
    LTEXT "defaults write org.p0deje.Maccy ignoreEvents true\r\n# 执行上述命令后再进行复制，然后执行\r\ndefaults write org.p0deje.Maccy ignoreEvents false", IDC_STATIC, 8, 47, 200, 42, SS_LEFT | SS_NOPREFIX
    LTEXT "您也可以按下 ⌥ 并单击菜单图标。\r\n要仅忽略下一个副本，请单击 ⌥⇧。", IDC_STATIC, 8, 91, 136, 28, SS_LEFT | SS_NOPREFIX
    LTEXT "defaults write org.p0deje.Maccy ignoreOnlyNextEvent true\r\n# 执行上述命令后再进行复制，只对下一次复制有效", IDC_STATIC, 8, 121, 224, 28, SS_LEFT | SS_NOPREFIX
    LTEXT "", IDC_STATIC, 8, 151, 416, 1, SS_ETCHEDHORZ
    CONTROL "退出时清除历史记录", IDC_X_CLEAR_ON_QUIT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 154, 80, 10
    CONTROL "同时清除系统剪贴板", IDC_X_CLEAR_CLIPBOARD, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 166, 80, 10
END

IDD_EDIT_PIN DIALOGEX 0, 0, 280, 200
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "编辑置顶项目"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "快捷键(&K)：", IDC_STATIC, 10, 10, 44, 14, SS_LEFT | SS_CENTERIMAGE
    COMBOBOX IDC_EDIT_PIN_KEY, 58, 10, 60, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "别名(&T)：", IDC_STATIC, 10, 30, 40, 10, SS_LEFT | SS_CENTERIMAGE
    EDITTEXT IDC_EDIT_PIN_TITLE, 10, 42, 260, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "内容(&C)：", IDC_STATIC, 10, 62, 40, 10, SS_LEFT | SS_CENTERIMAGE
    EDITTEXT IDC_EDIT_PIN_CONTENT, 10, 74, 260, 76, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_P_CONTENT_HINT, 10, 154, 260, 20, SS_LEFT | SS_CENTERIMAGE | SS_NOPREFIX
    DEFPUSHBUTTON "确定", IDOK, 164, 178, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 220, 178, 50, 14
END

IDD_EDIT_IGNORE DIALOGEX 0, 0, 280, 120
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
