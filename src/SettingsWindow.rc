    LTEXT "预览：", IDC_STATIC, 8, 120, 30, 14, SS_LEFT
    CONTROL "", IDC_G_PREVIEW_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 40, 119, 120, 14, WS_EX_CLIENTEDGE

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 138, 416, 1
    LTEXT "搜索：", IDC_STATIC, 8, 148, 30, 14, SS_LEFT
    COMBOBOX IDC_G_SEARCH_MODE, 40, 147, 220, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 168, 416, 1
    LTEXT "行为：", IDC_STATIC, 8, 178, 30, 14, SS_LEFT
    CONTROL "自动粘贴", IDC_G_PASTE_BY_DEFAULT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 177, 300, 10
    CONTROL "纯文本粘贴", IDC_G_REMOVE_FORMATTING, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 187, 320, 10
