    COMBOBOX IDC_A_HIGHLIGHT, 62, 94, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 113, 416, 1
    CONTROL "显示特殊符号", IDC_A_SHOW_SPECIAL, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 121, 330, 10
    CONTROL "显示菜单栏图标", IDC_A_SHOW_STATUS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 135, 180, 10
    COMBOBOX IDC_A_MENU_ICON, 192, 134, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "在菜单栏图标旁显示剪贴板内容", IDC_A_SHOW_RECENT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 149, 320, 10
    CONTROL "显示搜索框", IDC_A_SHOW_SEARCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 163, 180, 10
    COMBOBOX IDC_A_SEARCH_VISIBILITY, 192, 162, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "在搜索框前显示应用名", IDC_A_SHOW_TITLE, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 177, 190, 10
    CONTROL "显示应用程序图标", IDC_A_SHOW_ICONS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 187, 200, 10
    CONTROL "显示十六进制颜色色块", IDC_A_SHOW_SWATCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 197, 220, 10
