    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 247, 416, 1
    PUSHBUTTON "通知和声音", IDC_G_NOTIFICATIONS, 40, 257, 150, 16
END

IDD_PAGE_APPEARANCE DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
