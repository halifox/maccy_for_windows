    COMBOBOX IDC_A_POPUP_POSITION, 40, 5, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT "屏幕：", IDC_STATIC, 100, 5, 40, 14, SS_CENTERIMAGE
    COMBOBOX IDC_A_POPUP_SCREEN, 140, 5, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "重置位置", IDC_A_RESET_POSITION, 200, 5, 40, 14
    RTEXT "置顶到：", IDC_STATIC, 0, 21, 40, 14, SS_CENTERIMAGE
    COMBOBOX IDC_A_PIN_TO, 40, 21, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    RTEXT "图片高度：", IDC_STATIC, 0, 37, 40, 14, SS_CENTERIMAGE
