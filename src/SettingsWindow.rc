    CONTROL "文件", IDC_S_SAVE_FILES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 7, 24, 10
    CONTROL "图像", IDC_S_SAVE_IMAGES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 19, 24, 10
    CONTROL "文本", IDC_S_SAVE_TEXT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 31, 24, 10
    LTEXT "设置何种类型的内容会被保存。", IDC_STATIC, 40, 43, 112, 14, SS_LEFT | SS_CENTERIMAGE | SS_NOPREFIX
    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 59, 416, 1
    RTEXT "数量：", IDC_STATIC, 0, 62, 40, 14, SS_CENTERIMAGE
    EDITTEXT IDC_S_HISTORY_SIZE, 40, 62, 54, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_S_STORAGE_SIZE, 100, 62, 362, 14, SS_LEFT | SS_CENTERIMAGE | SS_NOPREFIX
