    LTEXT "预览", IDC_A_SECTION_PREVIEW, 8, 57, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "图片最大高度：", IDC_STATIC, 8, 74, 76, 14, SS_LEFT
    EDITTEXT IDC_A_IMAGE_HEIGHT, 88, 73, 54, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "像素（1–200）", IDC_STATIC, 148, 74, 100, 14, SS_LEFT
    CONTROL "自动打开预览", IDC_A_OPEN_PREVIEW, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 92, 220, 14
    LTEXT "预览宽度：", IDC_STATIC, 238, 92, 68, 14, SS_LEFT
    EDITTEXT IDC_A_PREVIEW_WIDTH, 310, 91, 54, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "px", IDC_STATIC, 370, 92, 24, 14, SS_LEFT
    LTEXT "预览延迟：", IDC_STATIC, 8, 110, 76, 14, SS_LEFT
    EDITTEXT IDC_A_PREVIEW_DELAY, 88, 109, 70, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "毫秒（200–100000）", IDC_STATIC, 164, 110, 130, 14, SS_LEFT

    LTEXT "搜索结果显示", IDC_A_SECTION_SEARCH, 8, 128, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "搜索匹配样式：", IDC_STATIC, 8, 145, 76, 14, SS_LEFT
    COMBOBOX IDC_A_HIGHLIGHT, 88, 144, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "托盘图标：", IDC_STATIC, 8, 163, 76, 14, SS_LEFT
    COMBOBOX IDC_A_MENU_ICON, 88, 162, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "显示托盘图标", IDC_A_SHOW_STATUS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 208, 162, 180, 14
    CONTROL "在托盘提示中显示最近复制内容", IDC_A_SHOW_RECENT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 180, 320, 14
    CONTROL "显示搜索框", IDC_A_SHOW_SEARCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 198, 190, 14
    COMBOBOX IDC_A_SEARCH_VISIBILITY, 208, 197, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "在搜索框前显示标题", IDC_A_SHOW_TITLE, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 216, 190, 14
    CONTROL "显示底部操作栏", IDC_A_SHOW_FOOTER, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 208, 216, 190, 14
    CONTROL "显示来源程序图标", IDC_A_SHOW_ICONS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 234, 200, 14
    CONTROL "显示十六进制颜色色块", IDC_A_SHOW_SWATCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 208, 234, 220, 14
    CONTROL "显示换行、制表符和首尾空格符号", IDC_A_SHOW_SPECIAL, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 252, 330, 14
END

IDD_PAGE_STORAGE DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "保存类型", IDC_S_SECTION_TYPES, 8, 5, 180, 14, SS_LEFT | SS_NOPREFIX
    CONTROL "文件（CF_HDROP）", IDC_S_SAVE_FILES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 22, 250, 14
    CONTROL "图片（DIB/DIBV5）", IDC_S_SAVE_IMAGES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 40, 250, 14
    CONTROL "文本（Unicode/HTML/RTF）", IDC_S_SAVE_TEXT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 58, 300, 14
    LTEXT "关闭某种类型后，新的剪贴板内容不会保存该类型；已有历史不会被删除。", IDC_STATIC, 8, 76, 416, 14, SS_LEFT | SS_NOPREFIX

    LTEXT "历史", IDC_S_SECTION_HISTORY, 8, 96, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "保留历史数量：", IDC_STATIC, 8, 114, 90, 14, SS_LEFT
    EDITTEXT IDC_S_HISTORY_SIZE, 102, 113, 54, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "条（1–999，不含置顶项）", IDC_STATIC, 162, 114, 160, 14, SS_LEFT
    LTEXT "排序：", IDC_STATIC, 8, 136, 90, 14, SS_LEFT
    COMBOBOX IDC_S_SORT_BY, 102, 135, 160, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "当前数据库大小：", IDC_STATIC, 8, 158, 90, 14, SS_LEFT
    LTEXT "", IDC_S_STORAGE_SIZE, 102, 158, 300, 14, SS_LEFT | SS_NOPREFIX
END

IDD_PAGE_IGNORE DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "忽略规则", IDC_I_SECTION_RULES, 8, 5, 180, 14, SS_LEFT | SS_NOPREFIX
    CONTROL "", IDC_IGNORE_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | TCS_TABS, 8, 23, 416, 246
END

IDD_IGNORE_APPLICATIONS DIALOGEX 0, 0, 408, 212
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LISTBOX IDC_I_LIST, 8, 8, 392, 104, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    EDITTEXT IDC_I_EDIT, 8, 120, 190, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    PUSHBUTTON "添加", IDC_I_ADD, 204, 119, 42, 16
    PUSHBUTTON "浏览…", IDC_I_BROWSE, 250, 119, 50, 16
    PUSHBUTTON "修改", IDC_I_UPDATE, 304, 119, 42, 16
    PUSHBUTTON "删除", IDC_I_REMOVE, 350, 119, 42, 16
    CONTROL "仅忽略列表中的应用（白名单）", IDC_I_WHITELIST, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 140, 260, 14
    LTEXT "忽略来自指定 Windows 应用程序的复制。建议优先使用剪贴板格式规则；列表中保存的是 exe 路径。\r\n开启白名单后，只记录列表中的应用。", IDC_I_DESCRIPTION, 8, 158, 392, 42, SS_LEFT | SS_NOPREFIX
END

IDD_IGNORE_FORMATS DIALOGEX 0, 0, 408, 212
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LISTBOX IDC_I_LIST, 8, 8, 392, 104, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    EDITTEXT IDC_I_EDIT, 8, 120, 190, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    PUSHBUTTON "添加", IDC_I_ADD, 204, 119, 42, 16
    PUSHBUTTON "修改", IDC_I_UPDATE, 250, 119, 42, 16
    PUSHBUTTON "删除", IDC_I_REMOVE, 296, 119, 42, 16
    PUSHBUTTON "恢复默认", IDC_I_RESET, 342, 119, 50, 16
    LTEXT "忽略指定的 Windows 剪贴板格式。可填写标准名称（如 CF_UNICODETEXT、CF_HDROP）或注册格式名称。恢复默认会清空 Windows 版自定义列表。", IDC_I_DESCRIPTION, 8, 158, 392, 42, SS_LEFT | SS_NOPREFIX
END

IDD_IGNORE_REGEXPS DIALOGEX 0, 0, 408, 212
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LISTBOX IDC_I_LIST, 8, 8, 392, 104, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    EDITTEXT IDC_I_EDIT, 8, 120, 190, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    PUSHBUTTON "添加", IDC_I_ADD, 204, 119, 42, 16
    PUSHBUTTON "修改", IDC_I_UPDATE, 250, 119, 42, 16
    PUSHBUTTON "删除", IDC_I_REMOVE, 296, 119, 42, 16
    LTEXT "当 Unicode 文本匹配任意有效正则表达式时，不会记录该次复制。无效表达式会被安全忽略。", IDC_I_DESCRIPTION, 8, 158, 392, 42, SS_LEFT | SS_NOPREFIX
END

IDD_PAGE_PINS DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "置顶项目", IDC_P_SECTION_PINS, 8, 5, 180, 14, SS_LEFT | SS_NOPREFIX
    LISTBOX IDC_P_LIST, 8, 23, 416, 72, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "按键：", IDC_STATIC, 8, 103, 70, 14, SS_LEFT
    EDITTEXT IDC_P_KEY, 82, 102, 140, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "标题：", IDC_STATIC, 8, 121, 70, 14, SS_LEFT
    EDITTEXT IDC_P_TITLE, 82, 120, 342, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "内容：", IDC_STATIC, 8, 139, 70, 14, SS_LEFT
    EDITTEXT IDC_P_CONTENT, 82, 138, 342, 54, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "只能编辑纯文本；图片和文件可以修改按键与标题，但内容保持原样。", IDC_P_CONTENT_HINT, 8, 199, 416, 24, SS_LEFT | SS_NOPREFIX
    PUSHBUTTON "保存置顶项", IDC_P_SAVE, 246, 232, 82, 16
    PUSHBUTTON "删除置顶项", IDC_P_DELETE, 334, 232, 80, 16
END

IDD_PAGE_ADVANCED DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "复制行为", IDC_X_SECTION_CLIPBOARD, 8, 5, 180, 14, SS_LEFT | SS_NOPREFIX
    CONTROL "暂时忽略所有新的复制", IDC_X_IGNORE_EVENTS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 23, 300, 14
    LTEXT "开启后不会记录新的剪贴板变化；“只忽略下一次”会在下一次变化后自动关闭。", IDC_STATIC, 8, 41, 416, 24, SS_LEFT | SS_NOPREFIX
    CONTROL "只忽略下一次复制", IDC_X_IGNORE_NEXT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 69, 260, 14
    LTEXT "macOS 中可通过 Option 点击菜单图标临时切换；Windows 版提供此处的等价设置。", IDC_STATIC, 8, 87, 416, 24, SS_LEFT | SS_NOPREFIX
    CONTROL "退出时清空历史", IDC_X_CLEAR_ON_QUIT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 119, 220, 14
    LTEXT "只删除未置顶项目。", IDC_STATIC, 240, 119, 150, 14, SS_LEFT
    CONTROL "同时清空系统剪贴板", IDC_X_CLEAR_CLIPBOARD, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 143, 230, 14
    LTEXT "启用后，清空历史也会调用 EmptyClipboard。", IDC_STATIC, 240, 143, 200, 14, SS_LEFT
END
