END

IDD_PAGE_GENERAL DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "登录时启动", IDC_G_LAUNCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 5, 48, 10
    CONTROL "自动检查更新", IDC_G_UPDATES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 17, 56, 10
    PUSHBUTTON "检查更新", IDC_G_CHECK_NOW, 40, 29, 40, 14

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 45, 416, 1
    RTEXT "打开：", IDC_STATIC, 0, 48, 40, 14, SS_CENTERIMAGE
    CONTROL "", IDC_G_OPEN_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 40, 48, 70, 14, WS_EX_CLIENTEDGE
    RTEXT "置顶：", IDC_STATIC, 0, 64, 40, 14, SS_CENTERIMAGE
    CONTROL "", IDC_G_PIN_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 40, 64, 70, 14, WS_EX_CLIENTEDGE
    RTEXT "删除：", IDC_STATIC, 0, 80, 40, 14, SS_CENTERIMAGE
    CONTROL "", IDC_G_DELETE_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 40, 80, 70, 14, WS_EX_CLIENTEDGE
    RTEXT "预览：", IDC_STATIC, 0, 96, 40, 14, SS_CENTERIMAGE
    CONTROL "", IDC_G_PREVIEW_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 40, 96, 70, 14, WS_EX_CLIENTEDGE

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 112, 416, 1
    RTEXT "搜索：", IDC_STATIC, 0, 115, 40, 14, SS_CENTERIMAGE
    COMBOBOX IDC_G_SEARCH_MODE, 40, 115, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 131, 416, 1
    RTEXT "行为：", IDC_STATIC, 0, 134, 40, 14, SS_CENTERIMAGE
    CONTROL "自动粘贴", IDC_G_PASTE_BY_DEFAULT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 136, 40, 10
    CONTROL "纯文本粘贴", IDC_G_REMOVE_FORMATTING, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 148, 48, 10
    LTEXT "自定义选择项目时的行为:\r\n• 按住 Enter 选择项目以复制。\r\n• 按住 Alt+Enter 选择项目以复制并粘贴。\r\n• 按住 Alt+Shift+Enter 选择项目以复制并匹配格式粘贴。", IDC_G_BEHAVIOR_HINT, 40, 160, 384, 36, SS_LEFT | SS_NOPREFIX

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 8, 198, 416, 1
    PUSHBUTTON "通知和声音", IDC_G_NOTIFICATIONS, 40, 201, 48, 14
END

IDD_PAGE_APPEARANCE DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
