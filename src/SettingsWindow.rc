IDD_PAGE_PINS DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "置顶项", IDC_P_SECTION_PINS, 8, 5, 180, 14, SS_LEFT | SS_NOPREFIX
    LISTBOX IDC_P_LIST, 8, 23, 416, 72, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "键位", IDC_STATIC, 8, 103, 70, 14, SS_LEFT
    EDITTEXT IDC_P_KEY, 82, 102, 140, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "标题", IDC_STATIC, 8, 121, 70, 14, SS_LEFT
    EDITTEXT IDC_P_TITLE, 82, 120, 342, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "内容", IDC_STATIC, 8, 139, 70, 14, SS_LEFT
    EDITTEXT IDC_P_CONTENT, 82, 138, 342, 54, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "只能编辑纯文本；图片和文件可以修改按键与标题，但内容保持原样。", IDC_P_CONTENT_HINT, 8, 199, 416, 24, SS_LEFT | SS_NOPREFIX
    PUSHBUTTON "保存置顶项", IDC_P_SAVE, 246, 232, 82, 16
    PUSHBUTTON "删除置顶项", IDC_P_DELETE, 334, 232, 80, 16
END

IDD_PAGE_ADVANCED DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "复制行为", IDC_X_SECTION_CLIPBOARD, 8, 5, 180, 14, SS_LEFT | SS_NOPREFIX
    CONTROL "暂停", IDC_X_IGNORE_EVENTS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 23, 300, 14
    LTEXT "暂停记录新的剪贴板项目。", IDC_STATIC, 8, 41, 416, 24, SS_LEFT | SS_NOPREFIX
    CONTROL "只忽略下一个副本", IDC_X_IGNORE_NEXT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 69, 260, 14
    LTEXT "", IDC_STATIC, 8, 87, 416, 24, SS_LEFT | SS_NOPREFIX
    CONTROL "退出时清除历史记录", IDC_X_CLEAR_ON_QUIT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 119, 220, 14
    LTEXT "退出应用时仅保留已置顶的项目（其他历史记录将被抛弃）。", IDC_STATIC, 240, 119, 185, 28, SS_LEFT
    CONTROL "同时清除系统剪贴板", IDC_X_CLEAR_CLIPBOARD, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 143, 230, 14
    LTEXT "启用后，清除历史记录也会清除当前系统剪贴板。", IDC_STATIC, 240, 143, 185, 28, SS_LEFT
END
