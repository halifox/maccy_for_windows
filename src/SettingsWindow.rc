IDD_PAGE_ADVANCED DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "暂停", IDC_X_IGNORE_EVENTS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 5, 300, 10
    LTEXT "暂停记录新的剪贴板项目。\r\n如果您想在复制敏感数据时通过程序调用来禁用本程序。", IDC_STATIC, 8, 23, 416, 28, SS_LEFT | SS_NOPREFIX
    LTEXT "defaults write org.p0deje.Maccy ignoreEvents true\r\n# 执行上述命令后再进行复制，然后执行\r\ndefaults write org.p0deje.Maccy ignoreEvents false", IDC_STATIC, 8, 55, 416, 42, SS_LEFT | SS_NOPREFIX
    LTEXT "您也可以按下 ⌥ 并单击菜单图标。\r\n要仅忽略下一个副本，请单击 ⌥⇧。", IDC_STATIC, 8, 101, 416, 28, SS_LEFT | SS_NOPREFIX
    LTEXT "defaults write org.p0deje.Maccy ignoreOnlyNextEvent true\r\n# 执行上述命令后再进行复制，只对下一次复制有效", IDC_STATIC, 8, 133, 416, 28, SS_LEFT | SS_NOPREFIX
    LTEXT "", IDC_STATIC, 8, 165, 416, 1, SS_ETCHEDHORZ
    CONTROL "退出时清除历史记录", IDC_X_CLEAR_ON_QUIT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 177, 230, 10
    CONTROL "同时清除系统剪贴板", IDC_X_CLEAR_CLIPBOARD, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 187, 230, 10
END

IDD_EDIT_PIN DIALOGEX 0, 0, 320, 200
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "编辑置顶项目"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "快捷键(&K)：", IDC_STATIC, 8, 10, 60, 14, SS_LEFT
    COMBOBOX IDC_EDIT_PIN_KEY, 72, 8, 240, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "别名(&T)：", IDC_STATIC, 8, 32, 60, 14, SS_LEFT
    EDITTEXT IDC_EDIT_PIN_TITLE, 72, 30, 240, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "内容(&C)：", IDC_STATIC, 8, 54, 60, 14, SS_LEFT
    EDITTEXT IDC_EDIT_PIN_CONTENT, 72, 52, 240, 90, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_P_CONTENT_HINT, 8, 148, 304, 20, SS_LEFT | SS_NOPREFIX
    DEFPUSHBUTTON "确定", IDOK, 152, 174, 75, 18
    PUSHBUTTON "取消", IDCANCEL, 237, 174, 75, 18
END

