IDD_PAGE_ADVANCED DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    CONTROL "暂停", IDC_X_IGNORE_EVENTS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 5, 300, 14
    LTEXT "暂停记录新的剪贴板项目。\r\n如果您想在复制敏感数据时通过程序调用来禁用本程序。", IDC_STATIC, 8, 21, 416, 28, SS_LEFT | SS_NOPREFIX
    LTEXT "defaults write org.p0deje.Maccy ignoreEvents true\r\n# 执行上述命令后再进行复制，然后执行\r\ndefaults write org.p0deje.Maccy ignoreEvents false", IDC_STATIC, 8, 51, 416, 42, SS_LEFT | SS_NOPREFIX
    LTEXT "您也可以按下 ⌥ 并单击菜单图标。\r\n要仅忽略下一个副本，请单击 ⌥⇧。", IDC_STATIC, 8, 95, 416, 28, SS_LEFT | SS_NOPREFIX
    LTEXT "defaults write org.p0deje.Maccy ignoreOnlyNextEvent true\r\n# 执行上述命令后再进行复制，只对下一次复制有效", IDC_STATIC, 8, 125, 416, 28, SS_LEFT | SS_NOPREFIX
    LTEXT "", IDC_STATIC, 8, 155, 416, 1, SS_ETCHEDHORZ
    CONTROL "退出时清除历史记录", IDC_X_CLEAR_ON_QUIT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 158, 230, 14
    CONTROL "同时清除系统剪贴板", IDC_X_CLEAR_CLIPBOARD, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 174, 230, 14
END

IDD_EDIT_PIN DIALOGEX 0, 0, 320, 200
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "编辑置顶项目"
FONT 9, "Segoe UI"
BEGIN
