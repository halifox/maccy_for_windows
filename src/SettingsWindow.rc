    CONTROL "自动打开预览", IDC_A_OPEN_PREVIEW, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 55, 56, 10
    RTEXT "预览延迟：", IDC_STATIC, 0, 67, 40, 14, SS_CENTERIMAGE
