#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 560, 420
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_APPWINDOW | WS_EX_CONTROLPARENT
CAPTION "Clipboard Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SETTINGS_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP, 8, 8, 544, 404
END
