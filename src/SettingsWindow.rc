    CONTROL "自动打开预览", IDC_A_OPEN_PREVIEW, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 59, 220, 10
