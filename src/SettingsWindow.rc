    LTEXT "", IDC_P_CONTENT_HINT, 8, 132, 304, 20, SS_LEFT | SS_NOPREFIX
    DEFPUSHBUTTON "确定", IDOK, 152, 154, 75, 14
    PUSHBUTTON "取消", IDCANCEL, 237, 154, 75, 14
END

