    LTEXT "屏幕：", IDC_STATIC, 180, 5, 30, 14, SS_LEFT
    COMBOBOX IDC_A_POPUP_SCREEN, 212, 4, 94, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
