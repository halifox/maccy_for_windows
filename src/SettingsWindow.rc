    COMBOBOX IDC_A_PIN_TO, 62, 22, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "图片高度：", IDC_STATIC, 8, 41, 52, 14, SS_LEFT
