#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

// Keep the settings dialog compact. Each page uses the same small content
// area, while list controls retain their own scrolling behavior.
IDD_SETTINGS DIALOGEX 0, 0, 456, 320
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_APPWINDOW | WS_EX_CONTROLPARENT
CAPTION "偏好设置"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SETTINGS_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | TCS_TABS, 8, 8, 440, 304
END

IDD_PAGE_GENERAL DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "启动与更新", IDC_G_SECTION_STARTUP, 8, 5, 180, 14, SS_LEFT | SS_NOPREFIX
    CONTROL "登录时启动", IDC_G_LAUNCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 21, 300, 14

    LTEXT "快捷键", IDC_G_SECTION_HOTKEYS, 8, 76, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "打开：", IDC_STATIC, 8, 94, 70, 14, SS_LEFT
    CONTROL "", IDC_G_OPEN_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 93, 120, 14, WS_EX_CLIENTEDGE
    LTEXT "置顶：", IDC_STATIC, 8, 112, 70, 14, SS_LEFT
    CONTROL "", IDC_G_PIN_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 111, 120, 14, WS_EX_CLIENTEDGE
    LTEXT "删除：", IDC_STATIC, 8, 130, 70, 14, SS_LEFT
    CONTROL "", IDC_G_DELETE_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 129, 120, 14, WS_EX_CLIENTEDGE
    LTEXT "预览：", IDC_STATIC, 8, 148, 70, 14, SS_LEFT
    CONTROL "", IDC_G_PREVIEW_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 147, 120, 14, WS_EX_CLIENTEDGE

    LTEXT "行为：", IDC_G_SECTION_BEHAVIOR, 8, 170, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "搜索：", IDC_STATIC, 8, 188, 78, 14, SS_LEFT
    COMBOBOX IDC_G_SEARCH_MODE, 90, 187, 220, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "自动粘贴", IDC_G_PASTE_BY_DEFAULT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 209, 300, 14
    CONTROL "纯文本粘贴", IDC_G_REMOVE_FORMATTING, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 227, 320, 14
    LTEXT "", IDC_G_BEHAVIOR_HINT, 8, 242, 416, 14, SS_LEFT | SS_NOPREFIX
END

IDD_PAGE_APPEARANCE DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "弹窗位置：", IDC_A_SECTION_POPUP, 8, 5, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "弹窗位置：", IDC_STATIC, 8, 22, 76, 14, SS_LEFT
    COMBOBOX IDC_A_POPUP_POSITION, 88, 21, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "屏幕：", IDC_STATIC, 206, 22, 40, 14, SS_LEFT
    COMBOBOX IDC_A_POPUP_SCREEN, 246, 21, 94, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "重置位置", IDC_A_RESET_POSITION, 348, 20, 66, 16
    LTEXT "置顶到：", IDC_STATIC, 8, 40, 76, 14, SS_LEFT
    COMBOBOX IDC_A_PIN_TO, 88, 39, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT "预览", IDC_A_SECTION_PREVIEW, 8, 57, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "图片高度：", IDC_STATIC, 8, 74, 76, 14, SS_LEFT
    EDITTEXT IDC_A_IMAGE_HEIGHT, 88, 73, 54, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    CONTROL "自动打开预览", IDC_A_OPEN_PREVIEW, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 92, 220, 14
    LTEXT "预览延迟：", IDC_STATIC, 8, 110, 76, 14, SS_LEFT
    EDITTEXT IDC_A_PREVIEW_DELAY, 88, 109, 70, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "毫秒（200–100000）", IDC_STATIC, 164, 110, 130, 14, SS_LEFT

    LTEXT "搜索结果显示", IDC_A_SECTION_SEARCH, 8, 128, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "高亮匹配：", IDC_STATIC, 8, 145, 76, 14, SS_LEFT
    COMBOBOX IDC_A_HIGHLIGHT, 88, 144, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "菜单栏图标：", IDC_STATIC, 8, 163, 76, 14, SS_LEFT
    COMBOBOX IDC_A_MENU_ICON, 88, 162, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "显示菜单栏图标", IDC_A_SHOW_STATUS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 208, 162, 180, 14
    CONTROL "在菜单栏图标旁显示剪贴板内容", IDC_A_SHOW_RECENT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 180, 320, 14
    CONTROL "显示搜索框", IDC_A_SHOW_SEARCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 198, 190, 14
    COMBOBOX IDC_A_SEARCH_VISIBILITY, 208, 197, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "在搜索框前显示应用名", IDC_A_SHOW_TITLE, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 216, 190, 14
    CONTROL "显示底部菜单", IDC_A_SHOW_FOOTER, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 208, 216, 190, 14
    CONTROL "显示应用程序图标", IDC_A_SHOW_ICONS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 234, 200, 14
    CONTROL "显示十六进制颜色色块", IDC_A_SHOW_SWATCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 208, 234, 220, 14
    CONTROL "显示特殊符号", IDC_A_SHOW_SPECIAL, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 252, 330, 14
END

IDD_PAGE_STORAGE DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "保存：", IDC_S_SECTION_TYPES, 8, 5, 180, 14, SS_LEFT | SS_NOPREFIX
    CONTROL "文件", IDC_S_SAVE_FILES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 22, 250, 14
    CONTROL "图像", IDC_S_SAVE_IMAGES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 40, 250, 14
    CONTROL "文本", IDC_S_SAVE_TEXT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 58, 300, 14
    LTEXT "设置何种类型的内容会被保存。", IDC_STATIC, 8, 76, 416, 14, SS_LEFT | SS_NOPREFIX

    LTEXT "历史", IDC_S_SECTION_HISTORY, 8, 96, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "数量：", IDC_STATIC, 8, 114, 90, 14, SS_LEFT
    EDITTEXT IDC_S_HISTORY_SIZE, 102, 113, 54, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "", IDC_STATIC, 162, 114, 160, 14, SS_LEFT
    LTEXT "排序：", IDC_STATIC, 8, 136, 90, 14, SS_LEFT
    COMBOBOX IDC_S_SORT_BY, 102, 135, 160, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "当前大小", IDC_STATIC, 8, 158, 90, 14, SS_LEFT
    LTEXT "", IDC_S_STORAGE_SIZE, 102, 158, 300, 14, SS_LEFT | SS_NOPREFIX
END

IDD_PAGE_IGNORE DIALOGEX 0, 0, 432, 276
