    RTEXT "高亮匹配：", IDC_STATIC, 0, 83, 40, 14, SS_CENTERIMAGE
    COMBOBOX IDC_A_HIGHLIGHT, 40, 83, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 40, 99, 416, 1
    CONTROL "显示特殊符号", IDC_A_SHOW_SPECIAL, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 102, 56, 10
    CONTROL "显示菜单栏图标", IDC_A_SHOW_STATUS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 114, 64, 10
    COMBOBOX IDC_A_MENU_ICON, 104, 112, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "在菜单栏图标旁显示剪贴板内容", IDC_A_SHOW_RECENT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 126, 120, 10
    CONTROL "显示搜索框", IDC_A_SHOW_SEARCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 138, 48, 10
    COMBOBOX IDC_A_SEARCH_VISIBILITY, 100, 136, 54, 14, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "在搜索框前显示应用名", IDC_A_SHOW_TITLE, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 150, 88, 10
    CONTROL "显示应用程序图标", IDC_A_SHOW_ICONS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 162, 72, 10
    CONTROL "显示十六进制颜色色块", IDC_A_SHOW_SWATCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 174, 88, 10
    CONTROL "显示底部菜单", IDC_A_SHOW_FOOTER, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 40, 186, 56, 10
