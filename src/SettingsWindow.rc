#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

// The settings window is intentionally fixed-size.  The page dialogs below
// use fixed dialog-unit coordinates; only list controls scroll internally.
IDD_SETTINGS DIALOGEX 0, 0, 480, 350
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_APPWINDOW | WS_EX_CONTROLPARENT
CAPTION "Clipboard Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SETTINGS_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | TCS_TABS, 8, 8, 464, 334
END

IDD_PAGE_GENERAL DIALOGEX 0, 0, 456, 306
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "启动与更新", IDC_G_SECTION_STARTUP, 8, 6, 180, 14, SS_LEFT | SS_NOPREFIX
    CONTROL "登录 Windows 时启动", IDC_G_LAUNCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 23, 300, 14
    CONTROL "自动检查更新（仅保存选项）", IDC_G_UPDATES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 41, 300, 14
    PUSHBUTTON "立即检查", IDC_G_CHECK_NOW, 330, 39, 80, 16
    LTEXT "Windows 版本没有 Sparkle 更新服务；“立即检查”会打开项目发布页。", IDC_STATIC, 8, 59, 430, 24, SS_LEFT | SS_NOPREFIX

    LTEXT "快捷键", IDC_G_SECTION_HOTKEYS, 8, 87, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "打开：", IDC_STATIC, 8, 105, 70, 14, SS_LEFT
    CONTROL "", IDC_G_OPEN_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 104, 120, 14, WS_EX_CLIENTEDGE
    LTEXT "置顶：", IDC_STATIC, 8, 127, 70, 14, SS_LEFT
    CONTROL "", IDC_G_PIN_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 126, 120, 14, WS_EX_CLIENTEDGE
    LTEXT "删除：", IDC_STATIC, 8, 149, 70, 14, SS_LEFT
    CONTROL "", IDC_G_DELETE_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 148, 120, 14, WS_EX_CLIENTEDGE
    LTEXT "预览：", IDC_STATIC, 8, 171, 70, 14, SS_LEFT
    CONTROL "", IDC_G_PREVIEW_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 170, 120, 14, WS_EX_CLIENTEDGE

    LTEXT "行为", IDC_G_SECTION_BEHAVIOR, 8, 197, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "搜索模式：", IDC_STATIC, 8, 215, 78, 14, SS_LEFT
    COMBOBOX IDC_G_SEARCH_MODE, 90, 214, 220, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "选择项目后自动粘贴", IDC_G_PASTE_BY_DEFAULT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 240, 300, 14
    CONTROL "默认粘贴为纯文本（去除格式）", IDC_G_REMOVE_FORMATTING, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 258, 320, 14
    PUSHBUTTON "Windows 通知和声音设置", IDC_G_NOTIFICATIONS, 8, 282, 220, 16
END

IDD_PAGE_APPEARANCE DIALOGEX 0, 0, 456, 306
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "弹出窗口", IDC_A_SECTION_POPUP, 8, 6, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "弹出位置：", IDC_STATIC, 8, 23, 82, 14, SS_LEFT
    COMBOBOX IDC_A_POPUP_POSITION, 94, 22, 120, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "屏幕：", IDC_STATIC, 220, 23, 44, 14, SS_LEFT
    COMBOBOX IDC_A_POPUP_SCREEN, 268, 22, 105, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "重置位置", IDC_A_RESET_POSITION, 378, 21, 66, 16
    LTEXT "置顶项目位置：", IDC_STATIC, 8, 41, 82, 14, SS_LEFT
    COMBOBOX IDC_A_PIN_TO, 94, 40, 120, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT "预览", IDC_A_SECTION_PREVIEW, 8, 58, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "图片最大高度：", IDC_STATIC, 8, 75, 82, 14, SS_LEFT
    EDITTEXT IDC_A_IMAGE_HEIGHT, 94, 74, 54, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "像素（1–200）", IDC_STATIC, 154, 75, 100, 14, SS_LEFT
    CONTROL "自动打开预览", IDC_A_OPEN_PREVIEW, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 93, 220, 14
    LTEXT "预览延迟：", IDC_STATIC, 8, 111, 82, 14, SS_LEFT
    EDITTEXT IDC_A_PREVIEW_DELAY, 94, 110, 70, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "毫秒（200–100000）", IDC_STATIC, 170, 111, 130, 14, SS_LEFT

    LTEXT "搜索结果显示", IDC_A_SECTION_SEARCH, 8, 129, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "搜索匹配样式：", IDC_STATIC, 8, 146, 82, 14, SS_LEFT
    COMBOBOX IDC_A_HIGHLIGHT, 94, 145, 120, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "托盘图标：", IDC_STATIC, 8, 164, 82, 14, SS_LEFT
    COMBOBOX IDC_A_MENU_ICON, 94, 163, 120, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "显示托盘图标", IDC_A_SHOW_STATUS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 224, 163, 180, 14
    CONTROL "在托盘提示中显示最近复制内容", IDC_A_SHOW_RECENT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 181, 320, 14
    CONTROL "显示搜索框", IDC_A_SHOW_SEARCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 199, 190, 14
    COMBOBOX IDC_A_SEARCH_VISIBILITY, 224, 198, 120, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "在搜索框前显示标题", IDC_A_SHOW_TITLE, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 217, 250, 14
    CONTROL "显示来源程序图标", IDC_A_SHOW_ICONS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 235, 200, 14
    CONTROL "显示十六进制颜色色块", IDC_A_SHOW_SWATCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 224, 235, 220, 14
    CONTROL "显示换行、制表符和首尾空格符号", IDC_A_SHOW_SPECIAL, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 253, 330, 14
    CONTROL "显示底部状态栏", IDC_A_SHOW_FOOTER, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 271, 220, 14
END

IDD_PAGE_STORAGE DIALOGEX 0, 0, 456, 306
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "保存类型", IDC_S_SECTION_TYPES, 8, 6, 180, 14, SS_LEFT | SS_NOPREFIX
    CONTROL "文件（CF_HDROP）", IDC_S_SAVE_FILES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 23, 250, 14
    CONTROL "图片（DIB/DIBV5）", IDC_S_SAVE_IMAGES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 41, 250, 14
    CONTROL "文本（Unicode/HTML/RTF）", IDC_S_SAVE_TEXT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 59, 300, 14
    LTEXT "关闭某种类型后，新的剪贴板内容不会保存该类型；已有历史不会被删除。", IDC_STATIC, 8, 77, 430, 24, SS_LEFT | SS_NOPREFIX

    LTEXT "历史", IDC_S_SECTION_HISTORY, 8, 108, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "保留历史数量：", IDC_STATIC, 8, 126, 90, 14, SS_LEFT
    EDITTEXT IDC_S_HISTORY_SIZE, 102, 125, 54, 14, ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "条（1–999，不含置顶项）", IDC_STATIC, 162, 126, 160, 14, SS_LEFT
    LTEXT "排序：", IDC_STATIC, 8, 148, 90, 14, SS_LEFT
    COMBOBOX IDC_S_SORT_BY, 102, 147, 160, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "当前数据库大小：", IDC_STATIC, 8, 170, 90, 14, SS_LEFT
    LTEXT "", IDC_S_STORAGE_SIZE, 102, 170, 300, 14, SS_LEFT | SS_NOPREFIX
END

IDD_PAGE_IGNORE DIALOGEX 0, 0, 456, 306
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "忽略规则", IDC_I_SECTION_RULES, 8, 6, 180, 14, SS_LEFT | SS_NOPREFIX
    CONTROL "", IDC_IGNORE_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | TCS_TABS, 8, 25, 440, 270
END

IDD_IGNORE_APPLICATIONS DIALOGEX 0, 0, 432, 236
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LISTBOX IDC_I_LIST, 8, 8, 416, 122, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    EDITTEXT IDC_I_EDIT, 8, 138, 220, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    PUSHBUTTON "添加", IDC_I_ADD, 234, 137, 42, 16
    PUSHBUTTON "浏览…", IDC_I_BROWSE, 280, 137, 50, 16
    PUSHBUTTON "修改", IDC_I_UPDATE, 334, 137, 42, 16
    PUSHBUTTON "删除", IDC_I_REMOVE, 380, 137, 42, 16
    CONTROL "仅忽略列表中的应用（白名单）", IDC_I_WHITELIST, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 158, 260, 14
    LTEXT "忽略来自指定 Windows 应用程序的复制。建议优先使用剪贴板格式规则；列表中保存的是 exe 路径。\r\n开启白名单后，只记录列表中的应用。", IDC_I_DESCRIPTION, 8, 180, 416, 42, SS_LEFT | SS_NOPREFIX
END

IDD_IGNORE_FORMATS DIALOGEX 0, 0, 432, 236
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LISTBOX IDC_I_LIST, 8, 8, 416, 122, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    EDITTEXT IDC_I_EDIT, 8, 138, 220, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    PUSHBUTTON "添加", IDC_I_ADD, 234, 137, 42, 16
    PUSHBUTTON "修改", IDC_I_UPDATE, 280, 137, 42, 16
    PUSHBUTTON "删除", IDC_I_REMOVE, 326, 137, 42, 16
    PUSHBUTTON "恢复默认", IDC_I_RESET, 372, 137, 50, 16
    LTEXT "忽略指定的 Windows 剪贴板格式。可填写标准名称（如 CF_UNICODETEXT、CF_HDROP）或注册格式名称。恢复默认会清空 Windows 版自定义列表。", IDC_I_DESCRIPTION, 8, 162, 416, 58, SS_LEFT | SS_NOPREFIX
END

IDD_IGNORE_REGEXPS DIALOGEX 0, 0, 432, 236
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LISTBOX IDC_I_LIST, 8, 8, 416, 122, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    EDITTEXT IDC_I_EDIT, 8, 138, 220, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    PUSHBUTTON "添加", IDC_I_ADD, 234, 137, 42, 16
    PUSHBUTTON "修改", IDC_I_UPDATE, 280, 137, 42, 16
    PUSHBUTTON "删除", IDC_I_REMOVE, 326, 137, 42, 16
    LTEXT "当 Unicode 文本匹配任意有效正则表达式时，不会记录该次复制。无效表达式会被安全忽略。", IDC_I_DESCRIPTION, 8, 162, 416, 42, SS_LEFT | SS_NOPREFIX
END

IDD_PAGE_PINS DIALOGEX 0, 0, 456, 306
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "置顶项目", IDC_P_SECTION_PINS, 8, 6, 180, 14, SS_LEFT | SS_NOPREFIX
    LISTBOX IDC_P_LIST, 8, 25, 440, 88, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "按键：", IDC_STATIC, 8, 121, 70, 14, SS_LEFT
    EDITTEXT IDC_P_KEY, 82, 120, 140, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "标题：", IDC_STATIC, 8, 143, 70, 14, SS_LEFT
    EDITTEXT IDC_P_TITLE, 82, 142, 360, 14, ES_AUTOHSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "内容：", IDC_STATIC, 8, 165, 70, 14, SS_LEFT
    EDITTEXT IDC_P_CONTENT, 82, 164, 360, 64, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP | WS_BORDER, WS_EX_CLIENTEDGE
    LTEXT "只能编辑纯文本；图片和文件可以修改按键与标题，但内容保持原样。", IDC_P_CONTENT_HINT, 8, 233, 434, 24, SS_LEFT | SS_NOPREFIX
    PUSHBUTTON "保存置顶项", IDC_P_SAVE, 270, 270, 90, 16
    PUSHBUTTON "删除置顶项", IDC_P_DELETE, 366, 270, 80, 16
END

IDD_PAGE_ADVANCED DIALOGEX 0, 0, 456, 306
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "复制行为", IDC_X_SECTION_CLIPBOARD, 8, 6, 180, 14, SS_LEFT | SS_NOPREFIX
    CONTROL "暂时忽略所有新的复制", IDC_X_IGNORE_EVENTS, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 24, 300, 14
    LTEXT "开启后不会记录新的剪贴板变化；“只忽略下一次”会在下一次变化后自动关闭。", IDC_STATIC, 8, 42, 430, 24, SS_LEFT | SS_NOPREFIX
    CONTROL "只忽略下一次复制", IDC_X_IGNORE_NEXT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 70, 260, 14
    LTEXT "macOS 中可通过 Option 点击菜单图标临时切换；Windows 版提供此处的等价设置。", IDC_STATIC, 8, 88, 430, 24, SS_LEFT | SS_NOPREFIX
    CONTROL "退出时清空历史", IDC_X_CLEAR_ON_QUIT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 120, 220, 14
    LTEXT "只删除未置顶项目。", IDC_STATIC, 240, 120, 150, 14, SS_LEFT
    CONTROL "同时清空系统剪贴板", IDC_X_CLEAR_CLIPBOARD, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 144, 230, 14
    LTEXT "启用后，清空历史也会调用 EmptyClipboard。", IDC_STATIC, 240, 144, 200, 14, SS_LEFT
END
