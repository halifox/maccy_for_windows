#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

// Keep the settings dialog compact. Each page uses the same small content
// area, while list controls retain their own scrolling behavior.
IDD_SETTINGS DIALOGEX 0, 0, 456, 320
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_APPWINDOW | WS_EX_CONTROLPARENT
CAPTION "Clipboard Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SETTINGS_TABS, "SysTabControl32", WS_CHILD | WS_VISIBLE | WS_TABSTOP | TCS_TABS, 8, 8, 440, 304
END

IDD_PAGE_GENERAL DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "启动与更新", IDC_G_SECTION_STARTUP, 8, 5, 180, 14, SS_LEFT | SS_NOPREFIX
    CONTROL "登录 Windows 时启动", IDC_G_LAUNCH, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 21, 300, 14
    CONTROL "自动检查更新（仅保存选项）", IDC_G_UPDATES, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 38, 300, 14
    PUSHBUTTON "立即检查", IDC_G_CHECK_NOW, 330, 36, 80, 16
    LTEXT "Windows 版本没有 Sparkle 更新服务；“立即检查”会打开项目发布页。", IDC_STATIC, 8, 55, 420, 14, SS_LEFT | SS_NOPREFIX

    LTEXT "快捷键", IDC_G_SECTION_HOTKEYS, 8, 76, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "打开：", IDC_STATIC, 8, 94, 70, 14, SS_LEFT
    CONTROL "", IDC_G_OPEN_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 93, 120, 14, WS_EX_CLIENTEDGE
    LTEXT "置顶：", IDC_STATIC, 8, 112, 70, 14, SS_LEFT
    CONTROL "", IDC_G_PIN_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 111, 120, 14, WS_EX_CLIENTEDGE
    LTEXT "删除：", IDC_STATIC, 8, 130, 70, 14, SS_LEFT
    CONTROL "", IDC_G_DELETE_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 129, 120, 14, WS_EX_CLIENTEDGE
    LTEXT "预览：", IDC_STATIC, 8, 148, 70, 14, SS_LEFT
    CONTROL "", IDC_G_PREVIEW_HOTKEY, "msctls_hotkey32", WS_TABSTOP | WS_VISIBLE, 82, 147, 120, 14, WS_EX_CLIENTEDGE

    LTEXT "行为", IDC_G_SECTION_BEHAVIOR, 8, 170, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "搜索模式：", IDC_STATIC, 8, 188, 78, 14, SS_LEFT
    COMBOBOX IDC_G_SEARCH_MODE, 90, 187, 220, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "选择项目后自动粘贴", IDC_G_PASTE_BY_DEFAULT, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 209, 300, 14
    CONTROL "默认粘贴为纯文本（去除格式）", IDC_G_REMOVE_FORMATTING, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 227, 320, 14
    PUSHBUTTON "Windows 通知和声音设置", IDC_G_NOTIFICATIONS, 8, 249, 220, 16
END

IDD_PAGE_APPEARANCE DIALOGEX 0, 0, 432, 276
STYLE WS_CHILD | DS_CONTROL | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "弹出窗口", IDC_A_SECTION_POPUP, 8, 5, 180, 14, SS_LEFT | SS_NOPREFIX
    LTEXT "弹出位置：", IDC_STATIC, 8, 22, 76, 14, SS_LEFT
    COMBOBOX IDC_A_POPUP_POSITION, 88, 21, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "屏幕：", IDC_STATIC, 206, 22, 40, 14, SS_LEFT
    COMBOBOX IDC_A_POPUP_SCREEN, 246, 21, 94, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "重置位置", IDC_A_RESET_POSITION, 348, 20, 66, 16
    LTEXT "置顶项目位置：", IDC_STATIC, 8, 40, 76, 14, SS_LEFT
    COMBOBOX IDC_A_PIN_TO, 88, 39, 112, 92, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "窗口：", IDC_STATIC, 206, 40, 38, 14, SS_LEFT
