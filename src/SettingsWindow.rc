    PUSHBUTTON "修改", IDC_I_UPDATE, 304, 119, 42, 16
    PUSHBUTTON "删除", IDC_I_REMOVE, 350, 119, 42, 16
    CONTROL "忽略列表之外的所有应用程序", IDC_I_WHITELIST, "Button", BS_AUTOCHECKBOX | BS_LEFT | BS_VCENTER | BS_MULTILINE | WS_TABSTOP, 8, 140, 300, 14
    LTEXT "", IDC_I_DESCRIPTION, 8, 158, 392, 42, SS_LEFT | SS_NOPREFIX
END

